  m_Script: {fileID: 11500000, guid: 82a1cc0faf2c6474caa547c2be9cbc42, type: 3}
  m_Name: SummitEnding
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: The air is warm up here.
    speaker: {fileID: 0}
  - text: <pause=0.5>You can see over the fog now.
    speaker: {fileID: 0}
  - text: It's still down there<pause=0.4>... but it doesn't feel as heavy.
    speaker: {fileID: 0}
  - text: You know the way up. <pause=0.4>You found it yourself.
    speaker: {fileID: 0}
  - text: And you didn't climb it alone.
    speaker: {fileID: 0}
  choices: []
  setFlagOnFinish: 
