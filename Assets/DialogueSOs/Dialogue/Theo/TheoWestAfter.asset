  choices:
  - text: Sure, let's go.
    responseLines:
    - text: <happy>Nice. Don't worry about how far you get. It's just moving.
      speaker: {fileID: 0}
    next: {fileID: 0}
    action:
      type: 2
      minigame: 3
      config: {fileID: 0}
      flag: theo_run_done
  - text: Maybe later.
    responseLines:
    - text: No pressure. I'll be around.
      speaker: {fileID: 0}
