MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82a1cc0faf2c6474caa547c2be9cbc42, type: 3}
  m_Name: TheoThought
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: '<heavy>I slipped off that ledge like <shake>ten times</shake>. Everyone probably saw.'
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  - text: '<heavy><speed=0.6>I always mess things up.</speed>'
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  choices:
  - text: Ten times is a lot.
    responseLines:
    - text: '<heavy>...Yeah. <pause=0.4>It is.'
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    - text: But that doesn't feel like the whole story, does it?
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    next: {fileID: 11400000}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  - text: Don't think about it!
    responseLines:
    - text: '<heavy>I wish it worked like that. It kind of just...<pause=0.3> sits there.'
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    next: {fileID: 11400000}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  - text: Always? You're up here.
    responseLines:
    - text: '...<pause=0.3>Huh.'
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    - text: I did keep trying. <pause=0.3>Ten times, and then I got it.
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    - text: '<happy>Maybe "I slipped a lot" and "I made it" are <pulse>both</pulse> true.'
      speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
    next: {fileID: 0}
    action:
      type: 1
      minigame: 0
      config: {fileID: 0}
      flag: theo_reframe_done
  setFlagOnFinish: 
