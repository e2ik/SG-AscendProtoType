  m_Script: {fileID: 11500000, guid: 82a1cc0faf2c6474caa547c2be9cbc42, type: 3}
  m_Name: TheoIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: Oh, hey. You new down here? Or does the fog just make everyone look new?
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  - text: 'I''m Theo. When it gets this thick I feel like I''m wading through wet
      sand.

'
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  - text: Weird thing is, moving helps. <pause=0.3>Even a little. It doesn't fix
      it... it just makes it lighter for a while.
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  - text: I do laps along the old aqueduct. Wanna come?
    speaker: {fileID: 11400000, guid: f53cc1da3f52d73469dea623f8416332, type: 2}
  choices:
  - text: Sure, let's go.
    responseLines:
    - text: <happy>Nice. Don't worry about how far you get. It's just moving.
      speaker: {fileID: 0}
    next: {fileID: 0}
    action:
      type: 2
      minigame: 3
      config: {fileID: 0}
      flag: theo_run_done
  - text: Maybe later.
    responseLines:
    - text: No pressure. I'll be around.
      speaker: {fileID: 0}
    next: {fileID: 0}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  setFlagOnFinish: 
