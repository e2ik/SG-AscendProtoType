  m_Script: {fileID: 11500000, guid: 82a1cc0faf2c6474caa547c2be9cbc42, type: 3}
  m_Name: Ana2Thought
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: 'They look way harder than the ones below.'
    speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
  - text: 'I just know I''ll freeze up and forget everything.'
    speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
  choices:
  - text: 'Maybe skip them, then.'
    responseLines:
    - text: '...Yeah. Maybe.'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    - text: 'But then I''d never know, would I?'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    next: {fileID: 11400000}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  - text: 'Don''t worry about it!'
    responseLines:
    - text: 'Easy to say. The worry doesn''t just switch off.'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    next: {fileID: 11400000}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  - text: 'Like last time?'
    responseLines:
    - text: '...Last time I was sure I''d fail too.'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    - text: 'And I matched more than I expected.'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    - text: '<happy>I guess I can''t really know until I try.'
      speaker: {fileID: 11400000, guid: 88c3d8357deafdb46ab20e3ca95e30a5, type: 2}
    next: {fileID: 0}
    action:
      type: 1
      minigame: 0
      config: {fileID: 0}
      flag: ana2_reframe_done
  setFlagOnFinish: 
