  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: <happy>You came back.
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  - text: 'I don''t think it makes the fog go away. It just makes it easier to stand
      in.

      Another round?'
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  choices:
  - text: Okay, I'll try.
    responseLines:
    - text: Just follow the light. There's no rush.
      speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
    next: {fileID: 0}
    action:
      type: 2
      minigame: 5
      config: {fileID: 11400000, guid: 3554ecafaf802da42b0605b381ba945f, type: 2}
      flag: wren_breath_done
  - text: Not right now.
    responseLines:
    - text: That's okay. I'll be here.
      speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
