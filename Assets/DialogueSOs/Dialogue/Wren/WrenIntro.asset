  m_Script: {fileID: 11500000, guid: 82a1cc0faf2c6474caa547c2be9cbc42, type: 3}
  m_Name: WrenIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: '<heavy>Hi. <pause=0.4>Sorry, I''m a bit slow today. The fog makes everything feel <speed=0.6>far away</speed>.'
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  - text: 'When it gets <shake>loud</shake> in my head, I breathe.<pause=0.3> <wave>In while the light rises...</wave><pause=0.3> <wave>out while it falls.</wave>'
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  - text: It sounds too simple. But it gives me somewhere to put my attention.
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  - text: Want to try it with me?
    speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
  choices:
  - text: Okay, I'll try.
    responseLines:
    - text: '<happy>Just follow the light. <speed=0.7>There''s no rush.</speed>'
      speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
    next: {fileID: 0}
    action:
      type: 2
      minigame: 5
      config: {fileID: 11400000, guid: 3554ecafaf802da42b0605b381ba945f, type: 2}
      flag: wren_breath_done
  - text: Not right now.
    responseLines:
    - text: That's okay. I'll be here.
      speaker: {fileID: 11400000, guid: 63aad5cc31ee9464fb00d3c4a6c4b784, type: 2}
    next: {fileID: 0}
    action:
      type: 0
      minigame: 0
      config: {fileID: 0}
      flag: 
  setFlagOnFinish: 
