  m_Script: {fileID: 11500000, guid: d1ef62657416e5749944b5a9b94a7ead, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RhythmReactions
  game: {fileID: 127431416}
  player: {fileID: 2091795159}
  npc: {fileID: 1465122247}
  lineDuration: 1.2
  bubbleScale: 1.7
  minGapPerSpeaker: 0.8
  npcGradeDelay: 1.2
  playerGradeDelay: 0.5
  successThreshold: 0.6
  npcStart:
    chance: 1
    lines:
    - Let's breathe together.
    - Nice and slow, {name}.
    - Follow the ring with me.
  npcBreatheIn:
    chance: 1
    lines:
    - Breathe in...
    - Deep breath in...
    - In through the nose...
  npcHold:
    chance: 0.4
    lines:
    - And hold...
    - Steady...
    - Almost there...
  npcBreatheOut:
    chance: 1
    lines:
    - Breathe out...
    - And out...
    - Let it all go...
  npcGrades:
    perfect:
      chance: 0.6
      lines:
      - Beautiful!
      - That's it!
      - Perfect rhythm.
    good:
      chance: 0.4
      lines:
      - Nice and steady.
      - Good breath.
    okay:
      chance: 0.3
      lines:
      - Getting there.
      - A little smoother next time.
    bad:
      chance: 0.6
      lines:
      - That's okay, take your time.
      - No rush. Try again.
      - Don't force it.
  npcFinishGood:
    chance: 1
    lines:
    - You did great, {name}.
    - Feel calmer?
    - Lovely breathing.
  npcFinishBad:
    chance: 1
    lines:
    - It takes practice.
    - We'll try again sometime.
    - Every breath helps.
  playerGrades:
    perfect:
      chance: 0.5
      lines:
      - Ahh, much better.
      - Woo... I feel calm.
    good:
      chance: 0.3
      lines:
      - Not bad.
      - Okay, that felt nice.
    okay:
      chance: 0.2
      lines:
      - Hmm, okay.
      - Bit shaky.
    bad:
      chance: 0.5
      lines:
      - Oops, rushed it.
      - Whoa, too quick.
      - Hmm...
  playerFinishGood:
    chance: 1
    lines:
    - I feel so much calmer.
    - That actually helped.
  playerFinishBad:
    chance: 1
    lines:
    - I need more practice...
    - Still a bit tense.
